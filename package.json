{
  "name": "iitj1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @iitj1/api",
    "dev:admin": "npm run dev -w @iitj1/admin",
    "dev:web": "npm run dev -w @iitj1/web",
    "dev:mobile": "npm run start -w @iitj1/mobile",
    "eas:android:production": "npm exec -w @iitj1/mobile -- eas-cli build --platform android --profile production",
    "eas:ios:production": "npm exec -w @iitj1/mobile -- eas-cli build --platform ios --profile production",
    "seed": "npm run seed -w @iitj1/api",
    "test:api": "npm run test -w @iitj1/api",
    "build:types": "npm run build -w @iitj1/types",
    "build:web": "npm run build -w @iitj1/web",
    "typecheck": "npm run typecheck -w @iitj1/types && npm run build -w @iitj1/types && npm run typecheck -w @iitj1/api && npm run typecheck -w @iitj1/admin && npm run typecheck -w @iitj1/web",
    "fix:brace-expansion": "node scripts/fix-brace-expansion.js",
    "prepare": "(husky || true) && npm run fix:brace-expansion && npm run build -w @iitj1/types",
    "test:unit": "npm run test:unit -w @iitj1/api",
    "test:rc": "npm run test:rc -w @iitj1/api"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "expo": "~58.0.22",
    "react-native": "0.88.1",
    "use-sync-external-store": "^1.6.0",
    "tar": "^7.5.22",
    "uuid": "^11.1.1",
    "firebase-admin": {
      "@google-cloud/firestore": {
        "google-gax": {
          "uuid": "^11.1.1"
        }
      },
      "@google-cloud/storage": {
        "teeny-request": {
          "uuid": "^11.1.1"
        }
      }
    },
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@mapbox/node-pre-gyp": {
      "tar": "^7.5.22"
    },
    "sharp": "^0.35.3",
    "next": {
      "postcss": "^8.5.18"
    },
    "@expo/metro-config": {
      "postcss": "^8.5.18"
    },
    "@expo/cli": {
      "minimatch": {
        "brace-expansion": "2.0.2"
      }
    },
    "minimatch@10": {
      "brace-expansion": "5.0.9"
    }
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "allowScripts": {
    "bcrypt": true,
    "esbuild": true,
    "protobufjs": true
  }
}
