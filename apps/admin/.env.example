# IITJ1 Admin Panel — copy to .env
#
# Same-origin proxy (recommended): Next.js rewrites /backend → Express :6002
# Avoids browser CORS / Cross-Origin-Resource-Policy issues.
NEXT_PUBLIC_API_URL=/backend/api/v1
NEXT_PUBLIC_CAMPUS_ID=iitj

# Where the Next.js rewrite proxies to (server-side only)
API_PROXY_TARGET=http://127.0.0.1:6002

# Direct URL alternative (not recommended for local browser admin):
# NEXT_PUBLIC_API_URL=http://localhost:6002/api/v1

# --- Live transport tooling (Phase 4 pilot config) — all optional, see lib/transportConfig.ts ---
# development | staging | production. Falls back to NEXT_PUBLIC_VERCEL_ENV, then NODE_ENV.
# NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_TRIPS_POLL_MS=4000
# NEXT_PUBLIC_HEALTH_POLL_MS=15000
# Absolute origin for the Socket.IO handshake — set this if the same-origin
# /backend rewrite doesn't proxy WebSocket upgrades in your deployment, or
# for Driver Mode on a phone browser over campus WiFi (a LAN IP).
# NEXT_PUBLIC_SOCKET_URL=http://192.168.1.50:6002
# NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
# NEXT_PUBLIC_DEBUG_LOGGING=true
# NEXT_PUBLIC_GPS_PUBLISH_INTERVAL_MS=3000

# --- Phase 5 reliability tooling — all optional, see lib/transportConfig.ts ---
# How often Diagnostics/Health/Incident views recompute a display refresh
# tick (not a new poll — they read the same shared opsDataStore data).
# NEXT_PUBLIC_DIAGNOSTICS_REFRESH_MS=5000
# Max replay ticks / activity+audit log entries kept in memory (Data Retention).
# NEXT_PUBLIC_REPLAY_RETENTION_TICKS=1800
# NEXT_PUBLIC_ACTIVITY_RETENTION_COUNT=500
# Reset "today's" pilot statistics automatically at local midnight.
# NEXT_PUBLIC_AUTO_RESET_PILOT_STATS_DAILY=true
# Incident Center thresholds — all can also be tuned live from Transport →
# Reliability → Settings without a rebuild; these env vars only set the
# starting defaults.
# NEXT_PUBLIC_THRESHOLD_BUSSTATE_STALE_MS=30000
# NEXT_PUBLIC_THRESHOLD_NO_CONTRIBUTORS_MS=300000
# NEXT_PUBLIC_THRESHOLD_GPS_FROZEN_MS=120000
# NEXT_PUBLIC_THRESHOLD_EXCESSIVE_ESTIMATED_MS=600000
# NEXT_PUBLIC_THRESHOLD_ROUTE_DEVIATION_M=400
# NEXT_PUBLIC_THRESHOLD_VEHICLE_UNASSIGNED_MS=300000
