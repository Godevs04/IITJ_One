{
  "expo": {
    "name": "IITJ One",
      "slug": "iitj-one",
      "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/branding/logo.png",
    "scheme": "iitj1",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#022543",
    "description": "Campus companion for IIT Jodhpur — mess menu, notices, transport, map, and more.",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/branding/marketing/ios-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#022543"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "4",
      "bundleIdentifier": "app.iitjone",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      },
      "splash": {
        "image": "./assets/branding/marketing/ios-splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#022543"
      }
    },
    "android": {
      "package": "app.iitjone",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon-foreground.png",
        "backgroundColor": "#022543"
      },
      "splash": {
        "image": "./assets/branding/marketing/android-splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#022543"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "./plugins/withStripMediaPermissions.js",
      "./plugins/withFirebaseMessagingManifestFix.js",
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/perf",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics",
              "RNFBCrashlytics",
              "RNFBMessaging",
              "RNFBPerf",
              "RNFBRemoteConfig"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#022543",
          "resizeMode": "cover",
          "ios": {
            "image": "./assets/branding/marketing/ios-splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#022543",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/branding/marketing/android-splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#022543"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification-icon.png",
          "color": "#1D3F5E",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "IITJ One uses the camera so you can photograph your Mess QR code.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "devPort": 6001,
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c307eca8-e310-4cfa-aca6-8c06b8fcd39f"
      }
    },
    "owner": "godevs",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#022543"
    }
  }
}
