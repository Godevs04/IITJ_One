{
  "name": "@iitj1/api",
  "version": "1.0.0",
  "private": true,
  "description": "IITJ One Express API — campus data for IIT Jodhpur",
  "main": "dist/index.js",
  "scripts": {
    "predev": "node ../../scripts/set-lan-ip.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:render": "node ./scripts/render-build.cjs",
    "prestart": "node ./scripts/ensure-dist.cjs",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:mess:august": "tsx scripts/seed-august-veg.ts && tsx scripts/seed-august-nonveg.ts",
    "seed:mess:september": "tsx scripts/seed-september-veg.ts && tsx scripts/seed-september-nonveg.ts",
    "seed:mess:november": "tsx scripts/seed-november-veg.ts && tsx scripts/seed-november-nonveg.ts",
    "seed:transport": "tsx scripts/seed-transport.ts",
    "calendar:import": "tsx scripts/import-academic-calendar.ts",
    "mess-pricing:seed": "tsx scripts/seed-mess-pricing.ts",
    "dev:isolated": "tsx scripts/dev-isolated-api.ts",
    "test": "node --import tsx --test --test-concurrency=1 src/tests/*.test.ts",
    "test:unit": "node --import tsx --test --test-concurrency=1 src/tests/parsers.test.ts src/tests/academicCalendar.test.ts src/tests/academicCalendarTimeline.test.ts src/tests/mobileNowLogic.test.ts src/tests/reminderLogic.test.ts src/tests/gpsValidation.test.ts src/tests/tripSchedule.test.ts src/tests/adminServices.test.ts src/tests/aiAdmin.test.ts src/tests/aiConversationalScenarios.test.ts src/tests/messAnnouncementFlow.test.ts src/tests/messPricing.test.ts src/tests/transportAnnouncementFlow.test.ts src/tests/transportCancellationFlow.test.ts",
    "test:rc": "tsx scripts/rc/runCi.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@iitj1/types": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.0",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "node-cache": "^5.1.2",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2"
  }
}
