# IITJ One Website — copy to .env.local
#
# Same-origin proxy (recommended): Next.js rewrites /backend -> Express :6002.
# Used only by the anonymous support/feedback form (POST /suggestions) —
# this site does not display live campus data (see memory: project_not_open_source.md).
NEXT_PUBLIC_API_URL=/backend/api/v1

# Server-side only — where the /backend rewrite proxies to.
API_PROXY_TARGET=http://127.0.0.1:6002

# Canonical production URL, used for metadataBase / sitemap / canonical / OG tags.
# MUST be the host that answers 200, not one that redirects. The live host
# redirects iitjone.in -> www.iitjone.in, so production is https://www.iitjone.in
# (or flip the redirect in the host's domain settings and use the apex).
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# The app is live on both stores, and lib/constants.ts already defaults to the
# real listings — leave these unset in production. Override only to point a
# staging build somewhere else, or set to an empty-ish sentinel when testing
# the pre-launch "Coming soon" state.
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.iitjone
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/in/app/iitjone/id6792112088

# Ownership tokens from Google Search Console / Bing Webmaster Tools (the
# content value of their HTML-tag verification method). Optional.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
